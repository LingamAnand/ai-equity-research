# Market data is disabled unless a provider is explicitly selected.
# Supported providers: unavailable, demo, yahoo, fyers.
# Demo figures are synthetic; Yahoo is unofficial. FYERS requires a server-side
# request-scoped OAuth token. Production display stays disabled until rights
# to display and retain market data are explicitly reviewed.
MARKET_DATA_PROVIDER=unavailable
FYERS_DATA_USE_APPROVED=false
MARKET_DATA_DISPLAY_RIGHTS_APPROVED=false

# FYERS API v3 credentials. Register the callback URL exactly in the FYERS app,
# then start login at /api/fyers/login. The resulting token is held in an
# HttpOnly, server-only cookie; a manually supplied token remains supported.
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=

# Supabase publishable key is used for normal server-side SSR access.
NEXT_PUBLIC_SUPABASE_URL=https://dxwjbpcdqaizkfnolisa.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged persistence key. Never use a NEXT_PUBLIC_ prefix or
# expose this value to browser code.
SUPABASE_SECRET_KEY=

# Use a Google AI Studio key from a project without billing enabled.
# Unpaid Gemini requests may be used to improve Google products; send public data only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# SEC EDGAR public-data request identification. Replace with a monitored email.
SEC_USER_AGENT=EquityMindAI/0.1 your-name your-real-contact-email
